{
  "name": "@nomos-guild/cgov-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node .build/index.js",
    "test:endpoints": "DISABLE_CRON_IN_API=true PORT=3001 jest --runInBand --testMatch='**/controller.test.ts' --forceExit",
    "test:validation": "jest --runInBand --testPathPatterns=cip179-v5.test.ts && npm run test:cip179",
    "test:businessLogic": "DISABLE_CRON_IN_API=true PORT=3003 jest --runInBand --testMatch='**/routes.test.ts' --forceExit",
    "test": "concurrently \"npm run test:endpoints\" \"npm run test:validation\" \"npm run test:businessLogic\"",
    "swagger:generate": "node swagger-generator.js",
    "test:sync": "ts-node test-sync.ts",
    "backfill:drep-snapshots": "ts-node src/scripts/backfill-drep-snapshots.ts",
    "backfill:epoch-totals": "ts-node src/scripts/backfill-epoch-totals.ts",
    "backfill:amount-at-switch": "ts-node src/scripts/backfill-amount-at-switch.ts",
    "test:cip179": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.9",
    "@meshsdk/core": "^1.9.0-beta.86",
    "@prisma/client": "^6.19.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.12.2",
    "bech32": "^2.0.0",
    "cip-179": "0.2.0",
    "class-validator": "^0.14.2",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "json-schema-to-ts": "^3.1.1",
    "node-cron": "^4.2.1",
    "puppeteer": "^22.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "test-node": "^0.0.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "3.2.7",
    "@electric-sql/pglite": "0.5.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@evolution-sdk/evolution": {
      "undici": "7.29.1"
    }
  }
}
